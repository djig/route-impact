{
  "name": "route-impact",
  "version": "0.1.0",
  "description": "Compute affected Next.js routes from git diffs and verify them with before/after screenshots, accessibility scans, and Web Vitals",
  "keywords": [
    "nextjs",
    "routes",
    "testing",
    "ci",
    "agent",
    "playwright",
    "accessibility",
    "web-vitals"
  ],
  "author": "Jignesh Dhamecha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/djig/route-impact.git"
  },
  "bin": {
    "route-impact": "./dist/cli.js"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "SKILL.md",
    "action.yml"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "demo": "cd examples/demo-app && npm run demo"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^8.15.0",
    "axe-core": "^4.10.2",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "picocolors": "^1.1.1",
    "playwright": "^1.49.1",
    "simple-git": "^3.27.0",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
